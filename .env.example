# Public browser configuration. These values are safe to expose when RLS is enabled.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Edge Function secret, configured with `supabase secrets set` (never VITE-prefixed).
# ALLOWED_ORIGINS=http://localhost:5173,https://your-name.github.io

# Phase 7 server-only secrets; configure these in the Edge Function secret store,
# not in the browser environment or committed files.
# SUPABASE_SERVICE_ROLE_KEY=server-only-project-key
# ALERTS_POLL_SECRET=random-scheduler-secret
# TTC_ALERTS_FEED_URL=https://gtfsrt.ttc.ca/alerts/subway?format=binary
